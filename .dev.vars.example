# Copy to .dev.vars for `npm run preview`. Do not commit .dev.vars.
# Production uses the same names via `npx wrangler secret put <NAME>`.
# Names and which ones are build-time vs runtime: docs/DEPLOY.md

NEXTJS_ENV=development

