# Site (set to your public HTTPS URL in production, e.g. https://slop.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Admin write lock for public deployments (campaigns, ad-revenue, referral admin)
# Required on Vercel to allow admin mutating APIs. Send as header: x-slop-admin-key
SLOP_ADMIN_KEY=

# Cloudflare R2 — recommended free cloud storage for mass MP4 uploads
# 1) Cloudflare dashboard → R2 → Create bucket (e.g. slop-videos)
# 2) Enable public access (custom domain or r2.dev public URL)
# 3) Manage R2 API Tokens → Create API token (Object Read & Write)
# 4) Fill these, then redeploy:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=slop-videos
# Public base URL with no trailing slash, e.g. https://pub-xxxxx.r2.dev or https://videos.yourdomain.com
R2_PUBLIC_BASE_URL=

# Vercel Blob — optional fallback (Hobby can suspend when limits are hit)
# Create a store in the Vercel dashboard → Blob → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Supabase (optional — demo mode works without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe ($7.99/mo Premium) — optional; checkout disabled until set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Ads — house (default Premium CTA) or AdSense after approval
# Admin checklist: /admin/ads
NEXT_PUBLIC_ADS_PROVIDER=house
# When AdSense is approved:
# NEXT_PUBLIC_ADS_PROVIDER=adsense
# NEXT_PUBLIC_ADS_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADS_SLOT_FEED=##########
# NEXT_PUBLIC_ADS_TEST_MODE=true
NEXT_PUBLIC_ADS_CLIENT_ID=
NEXT_PUBLIC_ADS_SLOT_FEED=
NEXT_PUBLIC_ADS_TEST_MODE=

# Analytics (optional — app records events locally without these)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Social auto-post (first N episodes on publish — default Ep 1 & 2)
SOCIAL_AUTO_POST_ENABLED=true
SOCIAL_AUTO_POST_EPISODES=1,2
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Zapier / Make / n8n catch hook for Instagram, TikTok, etc.
SOCIAL_WEBHOOK_URL=
