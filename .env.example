# Site (set to your public HTTPS URL in production, e.g. https://slop.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Admin write lock for public deployments (campaigns, ad-revenue, referral admin)
# Required on Vercel to allow admin mutating APIs. Send as header: x-slop-admin-key
SLOP_ADMIN_KEY=

# Supabase (optional — demo mode works without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe ($7.99/mo Premium) — optional; checkout disabled until set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional ad network (configure after approval)
NEXT_PUBLIC_ADS_PROVIDER=
NEXT_PUBLIC_ADS_CLIENT_ID=

# Analytics (optional — app records events locally without these)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
